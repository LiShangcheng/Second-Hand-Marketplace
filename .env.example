MONGO_URI=mongodb://mongo:27017
MONGO_DB=marketplace
PORT=5001
CORS_ORIGIN=http://localhost:3000

# Use "console" for local development, "smtp" for real email delivery.
MAIL_MODE=console
VERIFICATION_SECRET=replace-this-with-a-long-random-secret
VERIFICATION_TTL_MINUTES=10
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5

# Required when MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
